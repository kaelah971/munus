# CLIENT-SAFE: these values are embedded into the Vite bundle.
# Leave the API base empty when the API is served from the same origin.
VITE_MUNUS_API_BASE_URL=
# Set true only for local development. Never enable this in production.
VITE_MUNUS_LOCAL_AUTH=false
# Production builds default to remote auth; set this explicitly for deployment clarity.
VITE_MUNUS_PRODUCTION_AUTH=false
VITE_MUNUS_SESSION_MODE=remote

# SERVER-ONLY: never prefix these with VITE_ and never expose them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hosting platforms provide PORT; MUNUS_SERVER_PORT takes precedence for local runs.
PORT=8787
MUNUS_SERVER_PORT=8787
MUNUS_COOKIE_NAME=munus_session
MUNUS_COOKIE_SECURE=true
MUNUS_CHALLENGE_TTL_SECONDS=300
MUNUS_SESSION_TTL_SECONDS=2592000
MUNUS_NIMIQ_NETWORK=mainnet
# Optional development-only CORS origin when Vite and the API run on separate ports.
MUNUS_CORS_ORIGIN=http://localhost:5173
